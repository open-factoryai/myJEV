# ══════════════════════════════════════════════════════════════════════════
#  myJEV — environment
#
#  ONE file, two jobs:
#    1. `npm run dev` / `npm start`  → read by server/loadEnv.ts
#    2. `docker compose up`          → variable substitution + `env_file` for
#                                      the api / dev / all-in-one containers
#
#  cp .env.example .env      # then fill in what you need
#  NEVER commit .env. Secrets baked into an image layer are permanent.
# ══════════════════════════════════════════════════════════════════════════

# ── 1. LLM provider (modes: parallel | oneshot) ────────────────────────────
# At least ONE key is needed for LLM modes. Leave everything empty and use
# mode `mock` (or `docker compose --profile mock up`) for a fully offline demo.
OPENAI_API_KEY=
# MYJEV_API_KEY=            # generic fallback name, works for any provider
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, LiteLLM, Azure-style gateways…)
#   OpenAI            https://api.openai.com/v1
#   Groq              https://api.groq.com/openai/v1
#   Cerebras          https://api.cerebras.ai/v1
#   OpenRouter        https://openrouter.ai/api/v1
#   Together          https://api.together.xyz/v1
#   Mistral           https://api.mistral.ai/v1
#   Ollama (from Docker)   http://host.docker.internal:11434/v1
#   Ollama (on host)       http://localhost:11434/v1
#   vLLM                   http://localhost:8000/v1
OPENAI_BASE_URL=
# MYJEV_BASE_URL=           # alias of OPENAI_BASE_URL
MYJEV_MODEL=gpt-4o-mini

# ── 2. decider backend (Mapika/decider, mode: decider) ─────────────────────
# Inside compose use the service name. Default profile → the offline mock:
DECIDER_BASE_URL=http://mock:8000
# Real GPU server:
# DECIDER_BASE_URL=http://decider:8000
# Outside Docker:
# DECIDER_BASE_URL=http://localhost:8000
# DECIDER_API_KEY=local
ENABLE_DECIDER=true

# ── 3. Scoring defaults (per-request values from the UI override these) ────
MYJEV_DEFAULT_MODE=parallel      # parallel | oneshot | decider | mock
MYJEV_TEMPERATURE=0              # sampling temp of the scorer calls (0-2)
MYJEV_SOFTMAX_TEMPERATURE=1      # lower = sharper probability distribution
MYJEV_CONCURRENCY=8              # parallel scorer calls per request (1-64)
MYJEV_TIMEOUT_MS=60000           # per upstream call
MYJEV_RETRIES=2                  # on 429 / 5xx / network errors
MYJEV_MAX_TOKENS=32              # micro-scorer output budget
MYJEV_BATCH_MAX=200              # max items for POST /api/evaluate/batch
# MYJEV_SYSTEM_PROMPT_EXTRA=Answer conservatively; prefer "other" when unsure.

# ── 4. Server ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# NODE_ENV=production              # set by the images; leave unset for `npm run dev`
BODY_LIMIT=2mb
TRUST_PROXY=true                   # honour X-Forwarded-* from nginx/caddy
# CORS_ORIGINS=https://app.example.com,https://admin.example.com   # empty/"*" = allow all
# MYJEV_WEB_ROOT=/app/dist       # where the built SPA lives (single-image mode)

# ── 5. Security ────────────────────────────────────────────────────────────
# When set, every /api/* call needs `Authorization: Bearer <token>`
# (paste the same token into UI → Settings → Server).
# MYJEV_API_TOKEN=change-me-please
REQUIRE_AUTH=false
ALLOW_CLIENT_OVERRIDES=true        # false = ignore api_key/base_url/decider_url from clients
RATE_LIMIT_MAX=120                 # requests per window per IP+path (0 = off)
RATE_LIMIT_WINDOW_MS=60000

# ── 6. Observability ───────────────────────────────────────────────────────
LOG_REQUESTS=false                 # JSONL audit log of evaluate calls
LOG_FILE=logs/myjev.jsonl      # relative to the work dir (containers override to /app/logs)
LOG_MAX_BYTES=5242880              # rotate at 5 MB, keep 5 files

# ── 7. Docker / Compose knobs ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=myjev
IMAGE_NAMESPACE=myjev
IMAGE_TAG=latest
NODE_VERSION=22
MYJEV_VERSION=2.0.0
RESTART_POLICY=unless-stopped
READ_ONLY_FS=false

# host port mappings
WEB_PORT=8080                      # nginx (UI)
API_PORT=3001                      # node API (comment the `ports:` entry in compose to hide it)
AIO_PORT=3001                      # all-in-one profile
DEV_PORT=3001                      # dev profile (hot reload)
DEV_API_PORT=3002                  # dev-api profile
MOCK_PORT=8001                     # offline mock decider
DECIDER_PORT=8000                  # GPU decider
TLS_PORT=8443                      # caddy https
CADDY_HTTP_PORT=8081               # caddy http

# build
PUID=1001
PGID=1001
DEV_UID=1000
DEV_GID=1000
# Extra npm flags used while building the images. MUST stay empty or hold ONE
# whole flag — never put a trailing comment here, it would become part of the
# value and break `npm ci` (npm error code EINVALIDTAGNAME).
#   NPM_FLAGS=--registry=https://registry.npmmirror.com
NPM_FLAGS=
SERVER_MINIFY=true
VITE_SOURCEMAP=false
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
NETWORK_NAME=myjev
VOLUME_PREFIX=myjev

# resource limits (api)
API_CPUS=2.0
API_MEMORY=1g
API_MEMORY_RESERVATION=256m

# ── 8. GPU decider (profile: gpu) ──────────────────────────────────────────
DECIDER_CUDA_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
DECIDER_REF=main
DECIDER_MODEL=Mapika/decider-2b
DECIDER_BAKE_WEIGHTS=false         # true = download weights into the image at build time
DECIDER_SHM_SIZE=2gb
# HF_TOKEN=hf_...                  # for gated models
# DECIDER_WEIGHTS_PATH=./decider-weights

# ── 9. TLS front door (profile: tls) ───────────────────────────────────────
MYJEV_HOST=localhost             # set your real domain for Let's Encrypt
MYJEV_TLS_INTERNAL=internal      # "" + MYJEV_TLS_CERT/KEY for your own cert
MYJEV_AUTO_HTTPS=internal
# MYJEV_CERT_DIR=./certs

# ── 10. Watchtower (profile: ops) ──────────────────────────────────────────
WATCHTOWER_POLL_INTERVAL=86400
# WATCHTOWER_NOTIFICATIONS=slack

# ── 11. Registry push (scripts/docker-build.sh + GitHub Actions) ───────────
REGISTRY=ghcr.io
REGISTRY_NAMESPACE=open-factoryai
IMAGES=api web mock-decider
PLATFORMS=linux/amd64,linux/arm64
PUSH=false
