# ══════════════════════════════════════════════════════════════════════════
#  Minimal .env for Docker Compose deployments
#  cp .env.docker.example .env && docker compose --profile mock up -d --build
#
#  For the full list of knobs see .env.example.
# ══════════════════════════════════════════════════════════════════════════

# ── where to listen ────────────────────────────────────────────────────────
WEB_PORT=8080
API_PORT=3001

# ── pick ONE way to run ────────────────────────────────────────────────────
# (a) no keys at all → offline demo
MYJEV_DEFAULT_MODE=mock
DECIDER_BASE_URL=http://mock:8000

# (b) hosted LLM (parallel / oneshot)
# MYJEV_DEFAULT_MODE=parallel
# OPENAI_API_KEY=sk-...
# MYJEV_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# (c) local model server (Ollama / vLLM / LM Studio)
# MYJEV_DEFAULT_MODE=parallel
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# MYJEV_MODEL=qwen2.5:7b

# (d) real Mapika/decider weights on a GPU
# MYJEV_DEFAULT_MODE=decider
# DECIDER_BASE_URL=http://decider:8000
# DECIDER_MODEL=Mapika/decider-2b

# ── hardening (recommended for anything internet-facing) ───────────────────
# MYJEV_API_TOKEN=please-change-me
# REQUIRE_AUTH=true
ALLOW_CLIENT_OVERRIDES=true
CORS_ORIGINS=
RATE_LIMIT_MAX=120
LOG_REQUESTS=false

# ── tuning ─────────────────────────────────────────────────────────────────
MYJEV_CONCURRENCY=8
MYJEV_TIMEOUT_MS=60000
MYJEV_RETRIES=2
MYJEV_SOFTMAX_TEMPERATURE=1

# ── images / registry (CI + scripts/docker-build.sh) ───────────────────────
IMAGE_NAMESPACE=myjev
IMAGE_TAG=latest
NODE_VERSION=22
RESTART_POLICY=unless-stopped

# Linux note: run the containers as your own user so bind-mounted files
# (dev profile, logs) stay writable:
#   PUID=$(id -u)
#   PGID=$(id -g)

# macOS / Windows note: `host.docker.internal` works out of the box.
# On Linux add this to the api service in docker-compose.yml to reach a
# host-local Ollama/vLLM:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"
